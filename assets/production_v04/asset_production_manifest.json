{
  "schemaVersion": 4,
  "packageId": "catpat-forest-art-production-v04",
  "state": "audit-complete-generation-pending",
  "targetChapters": 4,
  "scopePhase": "chapter01-and-shared-assets; later chapters require separate versioned manifests",
  "expectedOutputImages": 336,
  "artDirection": {
    "style": "children's storybook gouache and soft pastel texture",
    "silhouette": "clear at mobile gameplay scale",
    "lighting": "soft upper-left key light, warm bounce, no hard photoreal highlights",
    "forbidden": [
      "cropped subject",
      "visible pixels touching canvas edge",
      "baked checkerboard",
      "baked white or colored background",
      "photorealistic texture",
      "unconnected pulley or rope",
      "alpha-derived gameplay collider",
      "silent fallback to legacy art"
    ]
  },
  "globalQuality": {
    "format": "PNG",
    "colorMode": "RGBA",
    "minimumTransparentMargin": 32,
    "preferredInteractiveMargin": 48,
    "cornerAlpha": 0,
    "alphaCutoffForBounds": 8,
    "maximumPivotDriftPixels": 1,
    "whiteHaloAllowed": false,
    "bakedCheckerboardAllowed": false,
    "croppedVisiblePixelsAllowed": false,
    "atlasPaddingPixels": 8,
    "atlasExtrusionPixels": 2,
    "colliderFromAlphaAllowed": false
  },
  "legacyAudit": [
    {
      "path": "assets/characters/catpat/animation_v02",
      "status": "REWORK",
      "files": 14,
      "finding": "Valid RGBA and no edge contact, but only 20px bottom margin and major clips are missing."
    },
    {
      "path": "assets/environments/forest/platforms_v02",
      "status": "REPLACE",
      "files": 8,
      "finding": "Valid RGBA, but only 12px bottom margin; old walkable polylines encouraged discontinuous physics."
    },
    {
      "path": "assets/environments/forest/decorations_v02",
      "status": "REWORK",
      "files": 8,
      "finding": "Valid RGBA; static only; several assets have 16-31px bottom margin."
    },
    {
      "path": "assets/gameplay/forest/objects_v02",
      "status": "REWORK",
      "files": 8,
      "finding": "All gameplay objects are single-frame prototypes; mushroom has only 22px bottom margin."
    },
    {
      "path": "assets/gameplay/forest/mechanisms_v03",
      "status": "REWORK_OR_REPLACE",
      "files": 5,
      "finding": "Valid RGBA but 11-16px margins; lift and swing are not split into physically coherent parts."
    },
    {
      "path": "assets/environments/forest/terrain_v04",
      "status": "REJECTED",
      "files": 3,
      "finding": "Long and short assets touch all canvas edges; medium PNG is truncated/corrupt."
    }
  ],
  "integrationRules": {
    "physics": [
      "Use explicit collider metadata; never infer collision from sprite alpha.",
      "Keep long traversal colliders continuous even when art contains rocks, roots or decorative gaps.",
      "Keep the rendered contact surface within 2px of the collider at target scale.",
      "Apply launch or activation events on the named event frame, not at clip start by default."
    ],
    "animation": [
      "All frames in one group use identical canvas, pivot and scale.",
      "Do not trim frames independently before runtime import.",
      "Preview loops forward and backward before atlas packing.",
      "Missing production groups are development errors, not placeholder fallbacks."
    ],
    "mechanisms": [
      "Split static supports from moving bodies.",
      "The lift uses a pulley-free vine rail and a separate moving platform.",
      "The swing rotates the complete hanging assembly around its top pivot while its support remains static.",
      "The gate panel translates independently inside the static gate frame."
    ]
  },
